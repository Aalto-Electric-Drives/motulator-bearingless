{
    "editor.rulers": [
        88
    ],
    "editor.formatOnType": false,
    "editor.formatOnSave": true,
    "editor.formatOnSaveMode": "file",
    "editor.codeActionsOnSave": {
        "source.fixAll.markdownlint": "explicit"
    },
    "editor.defaultFormatter": "charliermarsh.ruff",
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
            "source.fixAll.ruff": "explicit",
            "source.organizeImports.ruff": "explicit"
        }
    },
    "ruff.lineLength": 88,
    "esbonio.sphinx.confDir": "${workspaceFolder}/docs/source",
    "cSpell.words": [
        "autoapi",
        "bearingless",
        "Belahcen",
        "bibtex",
        "ECCE",
        "eccentricity",
        "Esbonio",
        "figsize",
        "fourpole",
        "Gruber",
        "Hinkkanen",
        "ICEM",
        "intersphinx",
        "ISMB",
        "Kontodinas",
        "levitation",
        "lims",
        "linalg",
        "mathbf",
        "mathjax",
        "mathrm",
        "matplotlib",
        "motulator",
        "Mukherjee",
        "multiphase",
        "ncols",
        "ndarray",
        "numpy",
        "numpydoc",
        "Pippuri",
        "PMSM",
        "pwms",
        "pylint",
        "Pyright",
        "pytest",
        "Saarakkala",
        "scipy",
        "sensored",
        "sensorless",
        "Sokolov",
        "SyRM",
        "Tammi",
        "titlesonly",
        "toctree",
        "upgreek",
        "uppsi",
        "xlabel",
        "xlim",
        "xtick",
        "ylabel",
        "ylabels",
        "ytick"
    ]
}
